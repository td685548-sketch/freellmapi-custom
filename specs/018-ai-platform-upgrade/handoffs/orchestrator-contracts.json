{
  "version": 1,
  "phase": "Delivery stage 7 / US7 / tasks Phase 9 (T115-T131)",
  "baseSha": "2493b57e",
  "sharedContractFile": "shared/ai-platform-orchestrator.ts",
  "limits": {
    "defaults": {
      "maxSteps": 12,
      "maxToolCalls": 20,
      "maxHandoffs": 4,
      "maxTokens": 60000,
      "maxSeconds": 120,
      "approvalTtlHours": 24
    },
    "hardCeilings": {
      "maxSteps": 50,
      "maxToolCalls": 100,
      "maxHandoffs": 10,
      "maxTokens": 500000,
      "maxSeconds": 600
    },
    "stepLogMaxBytes": 8192,
    "loopRepeatLimit": 3,
    "flowSlugRegex": "^[a-z0-9-]{1,48}$"
  },
  "ddl": {
    "migrationFile": "server/src/db/migrations/20261113_160000_custom_ai_orchestrator.ts",
    "tables": {
      "custom_ai_agents": {
        "columns": {
          "id": "INTEGER PRIMARY KEY AUTOINCREMENT",
          "slug": "TEXT NOT NULL UNIQUE",
          "name": "TEXT NOT NULL",
          "description": "TEXT NOT NULL DEFAULT ''",
          "model": "TEXT NOT NULL",
          "knowledge_scope_kind": "TEXT",
          "knowledge_scope_id": "TEXT",
          "output_policy_scope": "TEXT",
          "max_output_tokens": "INTEGER",
          "enabled": "INTEGER NOT NULL DEFAULT 1",
          "revision": "INTEGER NOT NULL DEFAULT 1"
        }
      },
      "custom_ai_flows": {
        "columns": {
          "id": "INTEGER PRIMARY KEY AUTOINCREMENT",
          "slug": "TEXT NOT NULL UNIQUE",
          "name": "TEXT NOT NULL",
          "description": "TEXT NOT NULL DEFAULT ''",
          "draft_json": "TEXT NOT NULL",
          "published_json": "TEXT",
          "published_version": "INTEGER NOT NULL DEFAULT 0",
          "enabled": "INTEGER NOT NULL DEFAULT 1",
          "revision": "INTEGER NOT NULL DEFAULT 1"
        }
      },
      "custom_ai_flow_grants": {
        "primaryKey": ["flow_id", "profile_id"]
      },
      "custom_ai_runs": {
        "columns": {
          "id": "TEXT PRIMARY KEY",
          "flow_id": "INTEGER NOT NULL",
          "flow_slug": "TEXT NOT NULL DEFAULT ''",
          "flow_version": "INTEGER NOT NULL",
          "profile_id": "INTEGER NOT NULL",
          "end_user": "TEXT",
          "wire": "TEXT NOT NULL",
          "status": "TEXT NOT NULL CHECK (status IN ('running', 'awaiting_approval', 'completed', 'stopped', 'cancelled', 'failed', 'interrupted'))",
          "stop_reason": "TEXT",
          "steps": "INTEGER NOT NULL DEFAULT 0",
          "tool_calls": "INTEGER NOT NULL DEFAULT 0",
          "handoffs": "INTEGER NOT NULL DEFAULT 0",
          "prompt_tokens": "INTEGER NOT NULL DEFAULT 0",
          "completion_tokens": "INTEGER NOT NULL DEFAULT 0",
          "final_text_masked": "TEXT",
          "error": "TEXT",
          "state_json": "TEXT",
          "is_dry_run": "INTEGER NOT NULL DEFAULT 0",
          "started_at": "TEXT NOT NULL DEFAULT (datetime('now'))",
          "finished_at": "TEXT"
        }
      },
      "custom_ai_run_steps": {
        "primaryKey": ["run_id", "seq"]
      }
    },
    "indexes": [
      "idx_custom_ai_runs_profile_started",
      "idx_custom_ai_runs_status",
      "idx_custom_ai_runs_flow_started"
    ],
    "triggers": [
      "trg_client_profiles_delete_orchestrator"
    ],
    "triggerSideEffectsTableUpdates": {
      "client_profiles": [
        "custom_ai_flow_grants",
        "custom_ai_run_steps",
        "custom_ai_runs"
      ]
    }
  },
  "routes": {
    "public": [
      { "method": "GET", "path": "/v1/ai/runs/:id", "auth": "sk-cp-..." }
    ],
    "admin": [
      { "method": "GET", "path": "/agents", "permission": "view_flows" },
      { "method": "POST", "path": "/agents", "permission": "edit_flows" },
      { "method": "GET", "path": "/agents/:id", "permission": "view_flows" },
      { "method": "PATCH", "path": "/agents/:id", "permission": "edit_flows" },
      { "method": "DELETE", "path": "/agents/:id", "permission": "edit_flows" },
      { "method": "GET", "path": "/flows", "permission": "view_flows" },
      { "method": "POST", "path": "/flows", "permission": "edit_flows" },
      { "method": "GET", "path": "/flows/:id", "permission": "view_flows" },
      { "method": "PUT", "path": "/flows/:id/draft", "permission": "edit_flows" },
      { "method": "POST", "path": "/flows/:id/try", "permission": "edit_flows" },
      { "method": "POST", "path": "/flows/:id/publish", "permission": "publish_flows" },
      { "method": "PUT", "path": "/flows/:id/grants", "permission": "publish_flows" },
      { "method": "DELETE", "path": "/flows/:id", "permission": "edit_flows" },
      { "method": "GET", "path": "/runs", "permission": "view_flow_runs" },
      { "method": "GET", "path": "/runs/:id", "permission": "view_flow_runs" },
      { "method": "POST", "path": "/runs/:id/cancel", "permission": "cancel_flow_runs" }
    ]
  },
  "inferenceErrors": {
    "flow_not_found": { "status": 404, "code": "flow_not_found" },
    "flow_not_granted": { "status": 403, "code": "flow_not_granted" },
    "flow_requires_client_key": { "status": 400, "code": "flow_requires_client_key" }
  },
  "workerOwnership": {
    "orch-foundation": [
      "server/src/db/migrations/20261113_160000_custom_ai_orchestrator.ts",
      "server/src/db/migrate/defaults.ts",
      "server/src/db/turso.ts",
      "server/src/__tests__/db/migrate/roundtrip.test.ts",
      "server/src/__tests__/db/turso-read-cache.test.ts",
      "server/src/__tests__/db/migrate/ai-platform-orchestrator.test.ts",
      "server/src/custom/x-gateway/combos.ts",
      "server/src/custom/ai-platform/orchestrator/definitions.ts",
      "server/src/__tests__/custom/ai-platform/flow-definitions.test.ts"
    ],
    "orch-limits-trace": [
      "server/src/custom/ai-platform/orchestrator/limits.ts",
      "server/src/custom/ai-platform/orchestrator/trace.ts",
      "server/src/__tests__/custom/ai-platform/flow-limits.test.ts"
    ],
    "orch-engine-runtime": [
      "server/src/custom/ai-platform/orchestrator/engine.ts",
      "server/src/custom/ai-platform/orchestrator/approvals.ts",
      "server/src/custom/ai-platform/orchestrator/runs-public.ts",
      "server/src/custom/ai-platform/orchestrator/router.ts",
      "server/src/custom/ai-platform/pipeline.ts",
      "server/src/middleware/profile-gate.ts",
      "server/src/custom/register.ts",
      "server/src/custom/ai-platform/router.ts",
      "server/src/__tests__/custom/ai-platform/flow-engine.test.ts",
      "server/src/__tests__/custom/ai-platform/flow-approvals.test.ts",
      "server/src/__tests__/custom/ai-platform/flow-e2e.test.ts"
    ],
    "orch-ui": [
      "client/src/custom/ai-platform/flows-api.ts",
      "client/src/custom/ai-platform/flows-strings.ts",
      "client/src/custom/ai-platform/components/RunTrace.tsx",
      "client/src/custom/ai-platform/pages/Flows.tsx",
      "client/src/custom/ai-platform/pages/Runs.tsx",
      "client/src/custom/ai-platform/flows.test.tsx",
      "client/src/custom/ai-platform/AiPlatformApp.tsx",
      "client/src/custom/i18n/vi.ts"
    ]
  }
}
