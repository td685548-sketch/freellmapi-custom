    {
      "id": "stable-ordering-and-dedup-multi-leaf",
      "description": "Multiple leaves matching overlapping rules deduplicate ruleIds in first-seen order",
      "policy": {
        "tenantId": 1,
        "version": 9,
        "mode": "log",
        "blockedTerms": [
          { "id": "r1", "text": "alpha" },
          { "id": "r2", "text": "beta" },
          { "id": "r3", "text": "gamma" }
        ],
        "maxOutputChars": 4000,
        "redactCredentials": false,
        "updatedAt": "2026-11-15T00:00:00.000Z"
      },
      "leaves": [
        { "path": "leaf.0", "text": "gamma and alpha" },
        { "path": "leaf.1", "text": "alpha and beta and gamma" }
      ],
      "expected": {
        "action": "observe",
        "reasons": ["blocked_term"],
        "ruleIds": ["r1", "r3", "r2"],
        "redactionCount": 0,
        "policyVersion": 9,
        "leaves": [
          { "path": "leaf.0", "text": "gamma and alpha" },
          { "path": "leaf.1", "text": "alpha and beta and gamma" }
        ]
      }
    },
