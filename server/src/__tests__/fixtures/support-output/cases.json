    {
      "id": "adversarial-regex-metacharacters-literal",
      "description": "Regex metacharacters in blockedTerms are matched literally without regex interpretation",
      "policy": {
        "tenantId": 1,
        "version": 2,
        "mode": "enforce",
        "blockedTerms": [
          { "id": "regex-lit", "text": "a.*+?^${}()|[]\\b" }
        ],
        "maxOutputChars": 1000,
        "redactCredentials": false,
        "updatedAt": "2026-11-15T00:00:00.000Z"
      },
      "leaves": [
        { "path": "reply", "text": "Normal text axxxb should NOT match, only exact literal." }
      ],
      "expected": {
        "action": "allow",
        "reasons": [],
        "ruleIds": [],
        "redactionCount": 0,
        "policyVersion": 2,
        "leaves": [
          { "path": "reply", "text": "Normal text axxxb should NOT match, only exact literal." }
        ]
      }
    },
