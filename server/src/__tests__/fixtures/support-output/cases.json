      },
      "leaves": [
        {
          "path": "reply",
          "text": "Xin Chào!\r\nAuth: Bearer eyJhbGciOiJIUzI1NiJ9.payload\r\nKey1: sk-proj-abc12345678\r\nKey2: sk_sup_live98765432\r\nCtx: sup_ctx_session_xyz123"
        },
        {
          "path": "trace.0",
